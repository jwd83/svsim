{
  "source": "simple8_programmable.sv",
  "memory_init": [
    {
      "module": "simple8_programmable",
      "memory": "instr_mem",
      "file": "demo_add_store.txt"
    }
  ],
  "test_cases": [
    {
      "name": "Adds two immediates, stores to RAM, and loads back",
      "sequence": [
        {
          "inputs": {"clk": 1, "reset": 1},
          "expected": {
            "pc_out": 0,
            "z_out": 0,
            "r0_out": 0,
            "r1_out": 0,
            "r2_out": 0,
            "r3_out": 0,
            "out_port": 0,
            "ram_10_out": 0
          }
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 1, "r0_out": 7}
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 2, "r1_out": 4}
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 3, "r0_out": 11}
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 4, "ram_10_out": 11}
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 5, "r2_out": 11, "z_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0},
          "expected": {"pc_out": 6, "ram_10_out": 11}
        }
      ]
    }
  ]
}
