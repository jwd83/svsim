        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 8, "trap": 0, "x1_out": 256, "x2_out": 85, "x3_out": 0, "mem0_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 8, "halted": 1, "trap": 1, "trap_cause": 7, "instr_debug": 2138147, "x1_out": 256, "x2_out": 85, "x3_out": 0, "mem0_out": 0}
