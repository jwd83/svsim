  "test_cases": [
    {
      "name": "Taken beq skips work and jal writes the link register",
      "sequence": [
        {
          "inputs": {"clk": 1, "reset": 1, "run": 0},
          "expected": {"pc": 0, "halted": 0, "x1_out": 0, "x2_out": 0, "x3_out": 0, "x4_out": 0, "x5_out": 0, "mem2_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 4, "x1_out": 9}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 8, "x2_out": 9}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 16}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 20, "x3_out": 42}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 28, "x5_out": 24}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 32, "x4_out": 66}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 36, "mem2_out": 66}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 36, "halted": 1, "x3_out": 42, "x4_out": 66, "x5_out": 24}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 36, "halted": 1, "mem2_out": 66}
        }
      ]
    }
  ]
}
