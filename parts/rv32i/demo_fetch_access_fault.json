{
  "source": "rv32i_cpu.sv",
  "sequential": true,
  "memory_files": {
    "rom": {
      "module": "rv32i_cpu",
      "memory": "imem",
      "file": "demo_fetch_access_fault.txt"
    }
  },
  "test_cases": [
    {
      "name": "Aligned jumps beyond imem raise an instruction access fault",
      "sequence": [
        {
          "inputs": {"clk": 1, "reset": 1, "run": 0},
          "expected": {"pc": 0, "halted": 0, "trap": 0, "trap_cause": 0, "x1_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 256, "halted": 0, "trap": 0, "trap_cause": 0, "x1_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 256, "halted": 1, "trap": 1, "trap_cause": 1, "instr_debug": 0, "x1_out": 0}
        }
      ]
    }
  ]
}
