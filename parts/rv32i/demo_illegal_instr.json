{
  "source": "rv32i_cpu.sv",
  "sequential": true,
  "memory_files": {
    "rom": {
      "module": "rv32i_cpu",
      "memory": "imem",
      "file": "demo_illegal_instr.txt"
    }
  },
  "test_cases": [
    {
      "name": "Unknown instructions trap instead of advancing silently",
      "sequence": [
        {
          "inputs": {"clk": 1, "reset": 1, "run": 0},
          "expected": {"pc": 0, "halted": 0, "trap": 0, "trap_cause": 0, "x1_out": 0, "x2_out": 0, "x3_out": 0}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 4, "trap": 0, "x1_out": 1}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 8, "trap": 0, "x2_out": 2}
        },
        {
          "inputs": {"clk": 1, "reset": 0, "run": 1},
          "expected": {"pc": 8, "halted": 1, "trap": 1, "trap_cause": 2, "instr_debug": 4294967295, "x1_out": 1, "x2_out": 2, "x3_out": 0}
        }
      ]
    }
  ]
}
